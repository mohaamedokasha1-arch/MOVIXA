<% if (typeof crumbs !== 'undefined' && crumbs && crumbs.length) { %>
<nav class="breadcrumbs container" aria-label="Breadcrumb">
  <ol>
    <% crumbs.forEach(function(c, i) { %>
      <li>
        <% if (c.href && i < crumbs.length - 1) { %><a href="<%= c.href %>"><%= c.label %></a><% } else { %><span aria-current="page"><%= c.label %></span><% } %>
        <% if (i < crumbs.length - 1) { %><span class="crumb-sep" aria-hidden="true">›</span><% } %>
      </li>
    <% }); %>
  </ol>
</nav>
<% } %>
