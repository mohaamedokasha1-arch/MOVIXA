<%- include('../partials/breadcrumbs') %>
<div class="container narrow">
  <h1 class="static-title"><%= page.title %></h1>
  <% if (page.content) { %><div class="rich-text static-body"><%- page.content %></div><% } %>
  <div class="contact-grid">
    <form class="contact-form" action="/contact" method="POST" novalidate>
      <div class="form-row">
        <div class="form-group">
          <label for="c-name">Name *</label>
          <input type="text" id="c-name" name="name" required minlength="2" maxlength="100" placeholder="Your name">
        </div>
        <div class="form-group">
          <label for="c-email">Email *</label>
          <input type="email" id="c-email" name="email" required maxlength="160" placeholder="you@example.com">
        </div>
      </div>
      <div class="form-group">
        <label for="c-subject">Subject</label>
        <input type="text" id="c-subject" name="subject" maxlength="160" placeholder="How can we help?">
      </div>
      <div class="form-group">
        <label for="c-message">Message *</label>
        <textarea id="c-message" name="message" rows="6" required minlength="10" maxlength="5000" placeholder="Write your message..."></textarea>
      </div>
      <button type="submit" class="btn btn-primary btn-lg">Send Message</button>
    </form>
    <aside class="contact-side">
      <h2>Other ways to reach us</h2>
      <% if (settings.contact_email) { %><p><strong>General:</strong> <a href="mailto:<%= settings.contact_email %>"><%= settings.contact_email %></a></p><% } %>
      <% if (settings.dmca_email) { %><p><strong>Copyright / DMCA:</strong> <a href="mailto:<%= settings.dmca_email %>"><%= settings.dmca_email %></a></p><% } %>
      <p class="muted">We aim to respond within 2 business days.</p>
    </aside>
  </div>
</div>
