<div class="page-actions"><h1 class="admin-h1">Subscribers (<%= pg.total %>)</h1></div>
<% if (items.length) { %>
<div class="table-wrap">
  <table class="admin-table">
    <thead><tr><th>Email</th><th>Subscribed</th><th>Actions</th></tr></thead>
    <tbody>
      <% items.forEach(function(s) { %>
      <tr>
        <td><strong><%= s.email %></strong></td>
        <td><small><%= H.timeAgo(s.created_at) %></small></td>
        <td class="actions"><button type="button" class="btn btn-danger btn-xs" data-delete="/admin/subscribers/delete/<%= s.id %>">Remove</button></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<%- include('../partials/pagination', { pg: pg, linkFor: function(p) { return `?page=${p}`; } }) %>
<% } else { %>
<div class="empty-state"><h2>No subscribers yet</h2><p>Newsletter signups will appear here.</p></div>
<% } %>
