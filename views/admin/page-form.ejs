<div class="page-actions">
  <h1 class="admin-h1"><%= isEdit ? 'Edit Page' : 'Add Custom Page' %></h1>
  <a href="/admin/pages" class="btn btn-ghost btn-sm">← Back to Pages</a>
</div>
<form method="POST" class="content-form narrow-form">
  <fieldset class="form-card">
    <div class="form-group"><label>Title *</label><input type="text" name="title" value="<%= page.title %>" required maxlength="200" data-slug-source></div>
    <div class="form-group"><label>Slug</label><input type="text" name="slug" value="<%= page.slug %>" maxlength="200" data-slug-target></div>
    <div class="form-group"><label>Content</label>
      <p class="form-note">HTML formatting supported: headings, paragraphs, lists, links, bold/italic.</p>
      <textarea name="content" rows="14" class="rich code"><%= page.content %></textarea>
    </div>
    <div class="form-group"><label>SEO Title</label><input type="text" name="seo_title" value="<%= page.seo_title %>" maxlength="200"></div>
    <div class="form-group"><label>SEO Description</label><textarea name="seo_description" rows="2" maxlength="200"><%= page.seo_description %></textarea></div>
    <div class="form-group"><label>Status</label>
      <label class="radio"><input type="radio" name="status" value="published" <%= page.status === 'published' ? 'checked' : '' %>> Published</label>
      <label class="radio"><input type="radio" name="status" value="draft" <%= page.status === 'draft' ? 'checked' : '' %>> Draft</label>
    </div>
    <button type="submit" class="btn btn-primary btn-lg"><%= isEdit ? 'Update Page' : 'Create Page' %></button>
  </fieldset>
</form>
