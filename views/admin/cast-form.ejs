<div class="page-actions">
  <h1 class="admin-h1"><%= isEdit ? 'Edit Person' : 'Add Person' %></h1>
  <a href="/admin/cast" class="btn btn-ghost btn-sm">← Back to Cast &amp; Crew</a>
</div>
<form method="POST" enctype="multipart/form-data" class="content-form narrow-form">
  <fieldset class="form-card">
    <div class="form-group"><label>Name *</label><input type="text" name="name" value="<%= person.name %>" required maxlength="120"></div>
    <div class="form-group"><label>Role</label>
      <select name="role">
        <option value="actor" <%= person.role === 'actor' ? 'selected' : '' %>>Actor</option>
        <option value="director" <%= person.role === 'director' ? 'selected' : '' %>>Director</option>
        <option value="writer" <%= person.role === 'writer' ? 'selected' : '' %>>Writer</option>
      </select>
    </div>
    <div class="form-group"><label>Photo</label>
      <% if (person.image) { %><img class="form-preview round" src="<%= person.image %>" alt=""><% } %>
      <input type="file" name="image_file" accept="image/*">
      <input type="text" name="image" value="<%= person.image %>" placeholder="...or paste image URL" maxlength="500">
    </div>
    <div class="form-group"><label>Bio</label><textarea name="bio" rows="4" maxlength="2000"><%= person.bio %></textarea></div>
    <button type="submit" class="btn btn-primary btn-lg"><%= isEdit ? 'Update Person' : 'Add Person' %></button>
  </fieldset>
</form>
