<div class="page-actions">
  <h1 class="admin-h1"><%= isEdit ? 'Edit Series' : 'Add New Series' %></h1>
  <div class="btn-row">
    <% if (isEdit) { %>
      <a href="/admin/series/<%= show.id %>/seasons" class="btn btn-primary btn-sm">Manage Seasons →</a>
      <a href="/series/<%= show.slug %>" target="_blank" rel="noopener" class="btn btn-ghost btn-sm">View on Site ↗</a>
    <% } %>
    <a href="/admin/series" class="btn btn-ghost btn-sm">← Back to Series</a>
  </div>
</div>

<% if (isEdit && typeof seasons !== 'undefined') { %>
<div class="form-card seasons-strip">
  <strong>Seasons (<%= seasons.length %>)</strong>
  <% seasons.forEach(function(s) { %><a class="pill pill-link" href="/admin/series/<%= show.id %>/season/<%= s.id %>/episodes"><%= s.title || ('Season ' + s.season_number) %> (<%= s.episodes_count %>)</a><% }); %>
  <a class="btn btn-secondary btn-xs" href="/admin/series/<%= show.id %>/seasons/new">+ Add Season</a>
</div>
<% } %>

<form method="POST" enctype="multipart/form-data" class="content-form">
  <div class="form-grid">
    <div class="form-main">
      <fieldset class="form-card">
        <legend>Basic Information</legend>
        <div class="form-group"><label>Title *</label><input type="text" name="title" value="<%= show.title %>" required maxlength="200" data-slug-source></div>
        <div class="form-row">
          <div class="form-group"><label>Original Title</label><input type="text" name="original_title" value="<%= show.original_title %>" maxlength="200"></div>
          <div class="form-group"><label>Slug</label><input type="text" name="slug" value="<%= show.slug %>" maxlength="200" data-slug-target placeholder="auto-generated"></div>
        </div>
        <div class="form-group"><label>Description</label><textarea name="description" rows="8" class="rich"><%= show.description %></textarea></div>
        <div class="form-group"><label>Short Description (max 200 chars)</label><textarea name="short_description" rows="2" maxlength="200" data-count="200"><%= show.short_description %></textarea><small class="char-count"></small></div>
      </fieldset>

      <fieldset class="form-card">
        <legend>Details</legend>
        <div class="form-row">
          <div class="form-group"><label>First Air Year</label><input type="number" name="first_air_year" value="<%= show.first_air_year %>" min="1900" max="2100"></div>
          <div class="form-group"><label>Last Air Year</label><input type="number" name="last_air_year" value="<%= show.last_air_year %>" min="1900" max="2100"></div>
          <div class="form-group"><label>Status</label>
            <select name="status">
              <option value="ongoing" <%= show.status === 'ongoing' ? 'selected' : '' %>>Ongoing</option>
              <option value="completed" <%= show.status === 'completed' ? 'selected' : '' %>>Completed</option>
              <option value="cancelled" <%= show.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group"><label>Language</label><input type="text" name="language" value="<%= show.language %>" maxlength="60"></div>
          <div class="form-group"><label>Country</label><input type="text" name="country" value="<%= show.country %>" maxlength="60"></div>
          <div class="form-group"><label>Rating (0–10)</label><input type="number" name="rating" value="<%= show.rating %>" min="0" max="10" step="0.1"></div>
        </div>
        <div class="form-group"><label>Tags (comma-separated)</label><input type="text" name="tags" value="<%= show.tags %>" maxlength="300"></div>
      </fieldset>

      <fieldset class="form-card">
        <legend>Media</legend>
        <div class="form-group"><label>Poster Image</label>
          <% if (show.poster_image) { %><img class="form-preview" src="<%= show.poster_image %>" alt="Current poster"><% } %>
          <input type="file" name="poster_file" accept="image/*">
          <input type="text" name="poster_image" value="<%= show.poster_image %>" placeholder="...or paste image URL" maxlength="500">
        </div>
        <div class="form-group"><label>Backdrop Image</label>
          <% if (show.backdrop_image) { %><img class="form-preview wide" src="<%= show.backdrop_image %>" alt="Current backdrop"><% } %>
          <input type="file" name="backdrop_file" accept="image/*">
          <input type="text" name="backdrop_image" value="<%= show.backdrop_image %>" placeholder="...or paste image URL" maxlength="500">
        </div>
        <div class="form-group"><label>Trailer URL (YouTube/Vimeo)</label><input type="url" name="trailer_url" value="<%= show.trailer_url %>" maxlength="500"></div>
      </fieldset>

      <fieldset class="form-card">
        <legend>SEO Settings</legend>
        <div class="form-group"><label>SEO Title</label><input type="text" name="seo_title" value="<%= show.seo_title %>" maxlength="200"></div>
        <div class="form-group"><label>SEO Description (max 200 chars)</label><textarea name="seo_description" rows="2" maxlength="200" data-count="200"><%= show.seo_description %></textarea><small class="char-count"></small></div>
        <div class="form-group"><label>OG Image</label>
          <input type="file" name="og_file" accept="image/*">
          <input type="text" name="og_image" value="<%= show.og_image %>" placeholder="...or paste image URL" maxlength="500">
        </div>
      </fieldset>
    </div>

    <div class="form-side">
      <fieldset class="form-card">
        <legend>Publishing</legend>
        <div class="form-group"><label>Status</label>
          <label class="radio"><input type="radio" name="publish_status" value="draft" <%= show.publish_status === 'draft' ? 'checked' : '' %>> Draft</label>
          <label class="radio"><input type="radio" name="publish_status" value="published" <%= show.publish_status === 'published' ? 'checked' : '' %>> Published</label>
          <label class="radio"><input type="radio" name="publish_status" value="archived" <%= show.publish_status === 'archived' ? 'checked' : '' %>> Archived</label>
        </div>
        <label class="check"><input type="checkbox" name="featured" value="1" <%= show.featured ? 'checked' : '' %>> ⭐ Featured (homepage hero)</label>
        <div class="publish-btns">
          <button type="submit" name="save_and_view" value="1" class="btn btn-ghost btn-block">Save &amp; View</button>
          <button type="submit" class="btn btn-primary btn-block btn-lg"><%= isEdit ? 'Update Series' : 'Save & Manage Seasons' %></button>
        </div>
      </fieldset>

      <fieldset class="form-card">
        <legend>Genres</legend>
        <div class="check-list">
          <% allGenres.forEach(function(g) { %>
          <label class="check"><input type="checkbox" name="genre_ids" value="<%= g.id %>" <%= selectedGenres.includes(g.id) ? 'checked' : '' %>> <%= g.name %></label>
          <% }); %>
        </div>
      </fieldset>

      <fieldset class="form-card">
        <legend>Cast &amp; Crew</legend>
        <div class="check-list cast-list">
          <% allPeople.forEach(function(p) {
            const sel = selectedCast.find(c => c.cast_id === p.id);
          %>
          <div class="cast-pick">
            <label class="check"><input type="checkbox" name="cast_ids" value="<%= p.id %>" <%= sel ? 'checked' : '' %>> <%= p.name %> <small class="muted">(<%= p.role %>)</small></label>
            <input type="text" name="character_<%= p.id %>" value="<%= sel ? sel.character_name : '' %>" placeholder="Character name" maxlength="120" class="cast-char">
          </div>
          <% }); %>
        </div>
      </fieldset>
    </div>
  </div>
</form>
